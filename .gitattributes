# LF everywhere, in the repository and in the working tree, regardless of core.autocrlf
# on a given machine. Ruff and the frontend tooling expect LF.
* text=auto eol=lf

# Windows shell scripts break with LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch line endings, no text diffs.
*.wav binary
*.png binary
*.jpg binary
*.ico binary
